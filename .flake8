[flake8]
max-line-length = 160
extend-ignore = E203, E266, E501, W503, E402, E701, W291, W293, E301, E302, E303, E305, E306, E741, F403, F405, F401, F841, E111, E117, E122, E127, E228, E231, E251, E261, E702, W292
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    ENV,
    env,
    build,
    dist,
    bot_workspace,
    temp_media,
    emoji_cache,
    avatar_cache,
    gift_cache,
    patcher.py
per-file-ignores =
    config/__init__.py:F401
    tools/__init__.py:F401
    config/config.py:F401
