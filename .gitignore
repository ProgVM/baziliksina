# .gitignore
# =====================================================================
# OS-Specific Files
# =====================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# =====================================================================
# IDEs and Text Editors
# =====================================================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# =====================================================================
# Python-Specific (Compiled bytecode, packaging, and caches)
# =====================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# =====================================================================
# Virtual Environments
# =====================================================================
.venv/
venv/
ENV/
env/
pip-log.txt
pip-delete-this-directory.txt

# =====================================================================
# Sensitive Userbot Auth & Session files (Critical Security)
# =====================================================================
# Telethon session files (contain raw authentication keys)
*.session
*.session-journal
baziliksina_session*
baziliksina_session.session*

# Local environment configuration file containing sensitive API keys
.env

# =====================================================================
# Project Databases & WAL (SQLite Storage)
# =====================================================================
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# =====================================================================
# Project Specific Workspaces & Caches
# =====================================================================
# Termux safe default DB directory
.baziliksina/

# Local download and media generation workspace
bot_workspace/

# Dynamic local caches (if spawned outside workspace)
emoji_cache/
avatar_cache/
gift_cache/
temp_media/

# Local config override
config/config.json

# Local prompts
config/*_local.txt

# =====================================================================
# Patches and Diffs
# =====================================================================
*.patch
*.diff

# =====================================================================
# Log Files
# =====================================================================
*.log
bot.log
web_server.log
