# =====================================================================
# 14. CACHE & ASSET FILE NAMES
# =====================================================================
EMOJI_CACHE_DIR_NAME=emoji_cache
AVATAR_CACHE_DIR_NAME=avatar_cache
GIFT_CACHE_DIR_NAME=gift_cache
TEMP_MEDIA_DIR_NAME=temp_media
BOT_AVATAR_NAME=bot_avatar.jpg
DEFAULT_IMAGE_NAME=generated_image.png
DEFAULT_AUDIO_NAME=generated_audio.mp3
DEFAULT_VIDEO_NAME=generated_video.mp4

RE_SEQ_BLOCK=<(seq|par|bg)>(.*?)</\1>
RE_REPLY_TAG=(?<!\\)\[Reply(?:\s+to\s+message\s+#?|:\s*)(\d+)\]
RE_REACT_TAG=(?<!\\)\[React:\s*(\d+)\s*\|\s*(.*?)\s*\]
RE_ATTACH_TAG=(?<!\\)\[Attach:\s*([^|\]]+?)\s*(?:\|\s*(.*?))?\s*\]
RE_EDIT_TAG=(?<!\\)\[Edit:\s*(\d+)\s*\|\s*(.*?)\s*\]
RE_DELETE_TAG=(?<!\\)\[Delete:\s*(\d+)\s*\]
RE_NOOP_TAG = os.getenv("RE_NOOP_TAG", r"(?<!\\)\[(?:NoOp|No_Op_Ignore|NoOpIgnore|idi_nahuy|ignore_this_eblan):\s*([^|\]]+?)\s*(?:\|\s*continue\s*=\s*(true|false))?\s*\]")
RE_TOOL_TAG=(?<!\\)\[Tool:\s*([a-zA-Z0-9_]+)\s*\|\s*(.*?)\s*\]
