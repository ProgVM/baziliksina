# .env.example
# =====================================================================
# BAZILIKSINA USERBOT UNIFIED CONFIGURATION MATRIX
# =====================================================================

# =====================================================================
# 1. TELEGRAM API & CORE CONFIGURATION
# =====================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=baziliksina_session
OWNER_ID=2113692455

# Root Admins JSON mapping: {user_id: {"rank": 100, "permissions": ["all"]}}
ADMINS={"2113692455": {"rank": 100, "permissions": ["all"]}, "5577696042": {"rank": 100, "permissions": ["all"]}}

# --- Telegram Connection Retries and Timeouts ---
TELEGRAM_CONNECT_TIMEOUT=15.0
TELEGRAM_CONNECTION_RETRIES=5
TELEGRAM_RETRY_DELAY=5.0
TELEGRAM_AUTO_RECONNECT=true
TELEGRAM_TIMEOUT=15.0

# =====================================================================
# 2. SQLITE ENGINE SETTINGS
# =====================================================================
DB_NAME=bot_context.db
SQLITE_JOURNAL_MODE=WAL
BOOTSTRAP_DATABASE=false

# =====================================================================
# 3. GOOGLE GEMINI AI CONFIGURATION
# =====================================================================
# Comma-separated list of Gemini API keys for key-rotation
GEMINI_API_KEYS=AIzaSyD_key1,AIzaSyD_key2,AIzaSyD_key3
# Comma-separated list of Gemini models for model-rotation
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash
THINKING_LEVEL=high
TEMPERATURE=0.7
TOP_P=0.95
STOP_SEQUENCES=
OUTPUT_LENGTH=65536
INPUT_TOKEN_LIMIT=524288

# Safety Filters: BLOCK_NONE, BLOCK_LOW_AND_ABOVE, BLOCK_MEDIUM_AND_ABOVE, BLOCK_ONLY_HIGH
SAFETY_HATE_SPEECH=BLOCK_NONE
SAFETY_HARASSMENT=BLOCK_NONE
SAFETY_SEXUALLY_EXPLICIT=BLOCK_NONE
SAFETY_DANGEROUS_CONTENT=BLOCK_NONE

CHARACTER_FILE=character.txt
FFMPEG_PATH=ffmpeg
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# =====================================================================
# 4. POLLINATIONS AI GENERATIVE MEDIA CONFIGURATION
# =====================================================================
POLLINATIONS_KEYS=plln_sk_key1,plln_pk_key2
DEFAULT_IMAGE_MODEL=flux
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024
MEDIA_RESOLUTION=high
ASPECT_RATIO=auto
GENERATE_IMAGE_TIMEOUT=180.0

DEFAULT_AUDIO_VOICE=nova
DEFAULT_AUDIO_MODEL=qwen-tts-instruct
GENERATE_AUDIO_TIMEOUT=120.0

DEFAULT_VIDEO_MODEL=wan
DEFAULT_VIDEO_DURATION=5
DEFAULT_VIDEO_ASPECT_RATIO=1:1
GENERATE_VIDEO_TIMEOUT=180.0

POLLINATIONS_SEED_MIN=1
POLLINATIONS_SEED_MAX=999999999
POLLINATIONS_UPLOAD_JPEG_QUALITY=95

DEFAULT_PUBLIC_UPLOAD_PROVIDER=auto
IMAGE_GEN_AUTO_DOWNLOAD=true
IMAGE_GEN_AUTO_UPLOAD_TO_GOOGLE=true
AUDIO_GEN_AUTO_DOWNLOAD=true
AUDIO_GEN_AUTO_UPLOAD_TO_GOOGLE=true
VIDEO_GEN_AUTO_DOWNLOAD=true
VIDEO_GEN_AUTO_UPLOAD_TO_GOOGLE=true
PUBLIC_UPLOAD_TIMEOUT=60.0

# =====================================================================
# 5. DUAL-ENGINE CONTEXT, TOKENS & FILE STRATEGIES
# =====================================================================
# Text context strategy: summarize, trim, hybrid, none
CONTEXT_MANAGEMENT_MODE=summarize
# Text limit count type: tokens or messages_count
TEXT_LIMIT_TYPE=tokens
TEXT_TOKEN_LIMIT=524288
CONTEXT_TRIM_COUNT=20
MESSAGES_LIMIT=150
CONTEXT_LOCAL_RATIO=0.7
CONTEXT_LOCAL_MIN_LIMIT=15
SUMMARIZATION_MESSAGES_LIMIT=500
SUMMARIZATION_KEEP_LIMIT=15
CROSS_CHAT_CONTEXT=true

# Media context strategy: trim, summarize, hybrid, none
FILE_CONTEXT_MODE=trim
# File limit count type: tokens or files_count
FILE_LIMIT_TYPE=tokens
FILE_TOKEN_LIMIT=200000
FILE_TRIM_COUNT=5
MEDIA_LIMIT=250

# Explicit File Inspection: Set false to log text metadata instead of auto-attaching binary bytes
AUTO_ATTACH_FILES_TO_CONTEXT=false

# DSL Rules for Auto Saving
AUTO_SAVE_TEXT_RULE=all
AUTO_SAVE_FILE_RULE=all

# =====================================================================
# 6. AI RESPONSE TRIGGERS, RULES & FLOW MATRIX
# =====================================================================
# AI Response Mode: all, private_only, group_only, channel_only
AI_RESPONSE_MODE=all
AI_RESPONSE_TRIGGERS=name,username,mentioned,reply_to_me

SAVE_INCOMING_MESSAGES=true
SAVE_EDITED_MESSAGES=true
SAVE_DELETED_MESSAGES=true

SAVE_OUTGOING_NEW_MESSAGES=true
SAVE_OUTGOING_EDITED_MESSAGES=true
SAVE_OUTGOING_DELETED_MESSAGES=true

TRIGGER_ON_INCOMING=true
TRIGGER_ON_EDITED=false
TRIGGER_ON_DELETED=false

TRIGGER_ON_OUTGOING_NEW_MESSAGES=false
TRIGGER_ON_OUTGOING_EDITED_MESSAGES=false
TRIGGER_ON_OUTGOING_DELETED_MESSAGES=false

TRIGGER_ON_OUTGOING_MANUAL_MESSAGES=false
TRIGGER_ON_COMMANDS=false

BOOTSTRAP_TRIGGER_GENERATION=true
CATCH_UP_TRIGGER_GENERATION=true
USE_SYSTEM_PROMPT=true

# =====================================================================
# 7. ADVANCED FILTERS & WHITELISTS / BLACKLISTS
# =====================================================================
FILTER_POLICY=blacklist_first

MSG_SAVE_WHITELIST=
MSG_SAVE_BLACKLIST=
MSG_GEN_WHITELIST=
MSG_GEN_BLACKLIST=
ALLOWED_MESSAGE_TYPES=text,voice,video,photo,document,gif,sticker,location,contact,poll,venue,album,list

SAVE_INCOMING_REACTION_ADD=true
SAVE_INCOMING_REACTION_REMOVE=true
SAVE_OUTGOING_REACTION_ADD=true
SAVE_OUTGOING_REACTION_REMOVE=true

TRIGGER_ON_INCOMING_REACTION_ADD=false
TRIGGER_ON_INCOMING_REACTION_REMOVE=false
TRIGGER_ON_OUTGOING_REACTION_ADD=false
TRIGGER_ON_OUTGOING_REACTION_REMOVE=false

REACTION_WHITELIST=
REACTION_BLACKLIST=

SAVE_USER_METADATA=true
SAVE_CHAT_METADATA=true

USER_CACHE_WHITELIST=
USER_CACHE_BLACKLIST=
CHAT_CACHE_WHITELIST=
CHAT_CACHE_BLACKLIST=

CHAT_WHITELIST=
CHAT_BLACKLIST=
READ_ACK_WHITELIST=all
READ_ACK_BLACKLIST=

AI_OUTPUT_WHITELIST_REGEX=
AI_OUTPUT_BLACKLIST_REGEX=

# =====================================================================
# 8. AI PIPELINE OPERATORS & GRANULAR CRUD+INVOKE PERMISSION MATRIX
# =====================================================================
AI_ALLOW_PIPELINES=true
AI_ALLOWED_PIPELINE_OPERATORS=;,&&,||,|
AI_BLOCKED_PIPELINE_OPERATORS=

AI_PERM_COMMANDS_CREATE=true
AI_PERM_COMMANDS_EDIT=true
AI_PERM_COMMANDS_DELETE=true
AI_PERM_COMMANDS_VIEW_INFO=true
AI_PERM_COMMANDS_VIEW_CONTENT=true
AI_PERM_COMMANDS_LIST=true
AI_PERM_COMMANDS_INVOKE=true

AI_PERM_TOOLS_CREATE=true
AI_PERM_TOOLS_EDIT=true
AI_PERM_TOOLS_DELETE=true
AI_PERM_TOOLS_VIEW_INFO=true
AI_PERM_TOOLS_VIEW_CONTENT=true
AI_PERM_TOOLS_LIST=true
AI_PERM_TOOLS_INVOKE=true

AI_PERM_TAGS_CREATE=true
AI_PERM_TAGS_EDIT=true
AI_PERM_TAGS_DELETE=true
AI_PERM_TAGS_VIEW_INFO=true
AI_PERM_TAGS_VIEW_CONTENT=true
AI_PERM_TAGS_LIST=true
AI_PERM_TAGS_INVOKE=true

AI_PERM_SERVICES_CREATE=true
AI_PERM_SERVICES_EDIT=true
AI_PERM_SERVICES_DELETE=true
AI_PERM_SERVICES_VIEW_INFO=true
AI_PERM_SERVICES_VIEW_CONTENT=true
AI_PERM_SERVICES_LIST=true
AI_PERM_SERVICES_INVOKE=true

AI_PERM_CRON_CREATE=true
AI_PERM_CRON_EDIT=true
AI_PERM_CRON_DELETE=true
AI_PERM_CRON_VIEW_INFO=true
AI_PERM_CRON_VIEW_CONTENT=true
AI_PERM_CRON_LIST=true
AI_PERM_CRON_INVOKE=true

AI_PERM_SITES_CREATE=true
AI_PERM_SITES_EDIT=true
AI_PERM_SITES_DELETE=true
AI_PERM_SITES_VIEW_INFO=true
AI_PERM_SITES_VIEW_CONTENT=true
AI_PERM_SITES_LIST=true
AI_PERM_SITES_INVOKE=true

AI_ALLOWED_ROOT_TOOLS=all
AI_BLOCKED_ROOT_TOOLS=execute_python_code,run_sandboxed_command
AI_ALLOWED_CUSTOM_TOOLS=all
AI_BLOCKED_CUSTOM_TOOLS=
AI_ALLOWED_MIMES=all
AI_BLOCKED_MIMES=none

# =====================================================================
# 9. SEGREGATED ROTATING PROXIES & LOCAL TOR CONFIGURATION
# =====================================================================
TELEGRAM_PROXIES=
GEMINI_PROXIES=socks5://127.0.0.1:10808
POLLINATIONS_PROXIES=
SCRAPER_PROXIES=
ALL_PROXY=

TOR_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_PASSWORD=your_tor_control_password
TOR_ROTATION_TIMEOUT=15.0

POLLINATIONS_MAX_ATTEMPTS=8
TOR_MAX_CONSECUTIVE_FAILURES=2
PROXY_CHECK_TIMEOUT=3.0
PROXY_TEST_TIMEOUT=3.0
PROXY_STRICT_CHECK=false

# =====================================================================
# 10. TIMEOUTS, INTERVALS & LIMITS
# =====================================================================
# DSL Examples:
# DEBOUNCE_DELAY=2.0:10|3.5:50|5.0:40
# TYPING_INTERVAL=10.0 ~ (2.0 + sin(get(step, 0)) * 1.5)
MAX_TURNS=1000
DEBOUNCE_DELAY=7.0
TIMERS_LOOP_INTERVAL=1.0
KEEP_ALIVE_INTERVAL=120
CONNECTION_MONITOR_INTERVAL=10
GEMINI_TIMEOUT=90.0
TYPING_INTERVAL=10.0
TIMEOUT_SLEEP=2.0
QUEUE_PROMOTION_DELAY=2.0
RATE_LIMIT_SLEEP=5.0
API_ERROR_SLEEP=2.0
PROFILE_UPDATE_INTERVAL=3600

BOT_RESPONSE_TIMEOUT=6.0
BUTTON_CLICK_TIMEOUT=15.0
DOWNLOAD_MEDIA_TIMEOUT=120.0
TELEGRAM_ACTION_TIMEOUT=60.0
CONVERSION_TIMEOUT=30.0
KEY_INFO_TIMEOUT=10.0
GOOGLE_UPLOAD_TIMEOUT=120.0

GEMINI_FREE_RECOVERY_TIME=18000
GEMINI_PRO_RECOVERY_TIME=86400
GEMINI_DEAD_KEY_COOLDOWN=31536000
POLLINATIONS_KEY_RECOVERY_TIME=3600

# Download media file size limit (in bytes): 500 MB = 524288000
MAX_FILE_SIZE=524288000
DUPLICATE_CACHE_SIZE=1000
AVATAR_CACHE_TIME=86400
DEFAULT_RESULT_INDEX=0

DIALOGS_LIMIT=50
BOOTSTRAP_MESSAGES_LIMIT=20
MISSED_MESSAGES_LIMIT=50

